# Voice agent configuration. Every service reads this one file.
# Change a value here, restart that one service. No code edits.

# ---------------------------------------------------------------- sockets
VA_ASR_SOCK=/run/voice-agent/asr.sock
VA_TTS_SOCK=/run/voice-agent/tts.sock

# ---------------------------------------------------------------- ears
# Source: file:/path.wav (16k mono) for testing without a mic,
#         alsa:plughw:1,0 once a USB mic or reSpeaker array is attached.
VA_ASR_AUDIO_IN=file:/opt/voice-agent/samples/input.wav
VA_ASR_MODEL=/home/mitlab/voice/models/whisper/ggml-base.en.bin
VA_ASR_WHISPER_BIN=/home/mitlab/whisper.cpp/build/bin/whisper-cli
VA_ASR_THREADS=1
VA_ASR_CHUNK_SEC=5

# ---------------------------------------------------------------- brain
# Any OpenAI-compatible server. Swap engines by changing this URL only:
#   llama.cpp   http://127.0.0.1:8080/v1/chat/completions
#   LiteRT-LM   http://127.0.0.1:9379/v1/chat/completions
VA_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
VA_LLM_MODEL=local
# Total output budget per turn. Re-read every turn, so the UI can change it.
# 200 is plenty with thinking off; with thinking on the reasoning channel alone
# can eat that and leave nothing for the answer, so the UI raises it to 700.
VA_LLM_MAX_TOKENS=200

# Hard cap on reasoning tokens (-1 unrestricted, 0 none). This is what stops
# thinking from consuming the whole budget and returning an empty answer.
VA_LLM_REASONING_BUDGET=-1
VA_LLM_SYSTEM=/opt/voice-agent/system-prompt.txt

# Model file + threads for the bundled llama.cpp unit. E2B, not E4B: 8.2 tok/s
# vs 3.7 is the difference between usable and not for speech.
VA_LLM_MODEL_PATH=/home/mitlab/models/gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
VA_LLM_THREADS=3
VA_LLM_CTX=4096

# Reasoning channel: off|on|auto. Toggleable from the UI.
# "on" improved E2B arithmetic from 7/10 to 10/10, at ~250 extra output tokens
# — about 30s of decode before the first spoken word on E2B, 68s on E4B.
VA_LLM_REASONING=off

# Speculative decoding (Gemma 4 MTP). Empty = off. The UI fills this in with
#   --spec-type draft-mtp --spec-draft-model <matching mtp head> --spec-draft-n-max 3
# Measured SLOWER on this CPU (0.55-0.96x across three engines) because a
# saturated 4-core verify costs ~N tokens for N drafts. Left off by default,
# but switchable so you can confirm it on your own workload.
VA_LLM_SPEC_ARGS=

# ---------------------------------------------------------------- mouth
# Sink: spool:<dir> writes one wav per clause for the web UI to play in the
# browser (right choice when the Pi has no speaker). alsa:default plays on the
# Pi itself; file:/path.raw just captures raw PCM.
VA_TTS_AUDIO_OUT=spool:/run/voice-agent/audio
VA_TTS_VOICE=/home/mitlab/voice/models/piper/en_US-amy-medium.onnx
VA_TTS_PIPER_BIN=/home/mitlab/voice/venv/bin/piper

# ---------------------------------------------------------------- tools
# The model calls these when it needs current information. Unset VA_TOOLS_SOCK
# and the orchestrator simply offers no tools — answers come from weights alone.
VA_TOOLS_SOCK=/run/voice-agent/tools.sock
# How many search-then-answer rounds one turn may take. Each round re-prefills
# the whole growing context, which is the expensive part on this board.
VA_MAX_TOOL_ROUNDS=2

# ddg needs no API key and no browser. searx needs VA_SEARX_URL.
VA_SEARCH_BACKEND=ddg
VA_SEARX_URL=
# Keep results small: every character is prefill the model must read back.
VA_SEARCH_RESULTS=4
VA_SEARCH_SNIPPET=420
VA_FETCH_CHARS=2500
VA_TOOL_TIMEOUT=15

# ---------------------------------------------------------------- flow
VA_HISTORY_TURNS=6
VA_FLUSH_CHARS=90
VA_BARGE_IN=1

# Observability seam. Orchestrator publishes JSON lines here; unset it and the
# orchestrator simply stops publishing (the agent itself is unaffected).
VA_EVENT_SOCK=/run/voice-agent/events.sock

# ---------------------------------------------------------------- web ui
# 0.0.0.0 means anyone on your LAN can talk to the agent — there is no auth.
# Use 127.0.0.1 plus `ssh -L 8090:localhost:8090 MITLAB-EDGE` to keep it private.
VA_WEB_HOST=0.0.0.0
VA_WEB_PORT=8090
VA_WEB_UI=/opt/voice-agent/ui.html
