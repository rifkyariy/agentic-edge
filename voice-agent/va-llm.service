[Unit]
# Brain. Any OpenAI-compatible server can take this slot — to switch to
# LiteRT-LM, replace ExecStart with:
#   /home/mitlab/litert-venv/bin/litert-lm serve --host 127.0.0.1 --port 9379
# and point VA_LLM_URL at that port. Nothing else in the stack changes.
Description=Voice agent: LLM (llama.cpp, OpenAI-compatible)
After=network.target

[Service]
User=mitlab
Group=mitlab
EnvironmentFile=/etc/voice-agent/config.env
# UI choices, loaded second so they win. The leading "-" means "fine if absent".
EnvironmentFile=-/etc/voice-agent/runtime.env
# $VA_LLM_SPEC_ARGS is written WITHOUT braces on purpose: systemd word-splits
# $VAR but not ${VAR}, and this one carries several arguments or none at all.
ExecStart=/home/mitlab/llama.cpp/build/bin/llama-server \
  -m ${VA_LLM_MODEL_PATH} \
  -t ${VA_LLM_THREADS} \
  -c ${VA_LLM_CTX} \
  --host 127.0.0.1 --port 8080 \
  -rea ${VA_LLM_REASONING} \
  --reasoning-budget ${VA_LLM_REASONING_BUDGET} \
  $VA_LLM_SPEC_ARGS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
