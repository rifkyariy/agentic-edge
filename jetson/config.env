# Voice agent configuration for the Jetson Orin Nano (user `ari`, uid 1002).
# Same keys as config/config.env; only what differs on this board is
# explained here — read that file for what each key means.
#
# Everything runs under `systemctl --user` (no passwordless sudo on this
# board), so the layout is in $HOME, not /opt and /etc:
#   ~/voice-agent/                code (deploy.sh copies it here)
#   ~/.config/voice-agent/        this file + runtime.env (the UI's choices)
#   /run/user/1002/voice-agent/   sockets + audio spool (RuntimeDirectory=)

VA_SYSTEMD_SCOPE=user
VA_CONFIG_FILE=/home/ari/.config/voice-agent/config.env
VA_RUNTIME_FILE=/home/ari/.config/voice-agent/runtime.env

# ---------------------------------------------------------------- sockets
VA_ASR_SOCK=/run/user/1002/voice-agent/asr.sock
VA_TTS_SOCK=/run/user/1002/voice-agent/tts.sock

# ---------------------------------------------------------------- ears
# No mic on the board: the browser mic (through va-web) is the input. va-asr
# gets a second of silence so it stays up without replaying an utterance.
VA_ASR_AUDIO_IN=file:/home/ari/voice/samples/silence.wav
VA_ASR_MODEL=/home/ari/voice/models/whisper/ggml-base.en.bin
VA_ASR_WHISPER_BIN=/home/ari/build/whisper.cpp/build/bin/whisper-cli
VA_ASR_THREADS=2
VA_ASR_CHUNK_SEC=5
VA_WEB_ASR_THREADS=4
VA_FFMPEG_BIN=/home/ari/voice/bin/ffmpeg

# ---------------------------------------------------------------- brain
# Port 8081, not 8080: the benchmark scripts serve on 8080 and pkill any
# `llama-server -m`. Stop the voice agent before queueing a benchmark anyway —
# one job per device (AGENTS.md §4.9); the queue's precheck refuses jobs while
# this server is up.
VA_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
VA_LLM_MODEL=local
VA_LLM_MAX_TOKENS=200
VA_LLM_REASONING_BUDGET=-1
VA_LLM_SYSTEM=/home/ari/voice-agent/system-prompt.txt

# The UI's model picker lists every non-mtp *.gguf here: E2B and E4B.
VA_MODELS_DIR=/home/ari/research/models
VA_LLM_MODEL_PATH=/home/ari/research/models/gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
VA_LLM_THREADS=4
VA_LLM_CTX=4096
VA_LLM_REASONING=off
VA_LLM_SPEC_ARGS=

# ---------------------------------------------------------------- mouth
VA_TTS_AUDIO_OUT=spool:/run/user/1002/voice-agent/audio
VA_TTS_VOICE=/home/ari/voice/models/piper/en_US-amy-medium.onnx
VA_TTS_PIPER_BIN=/home/ari/voice/venv/bin/piper
# piper-tts 1.2.0 rejects the Pi's --output-dir-naming; it names by timestamp.
VA_TTS_SPOOL_ARGS=

# ---------------------------------------------------------------- tools
VA_TOOLS_SOCK=/run/user/1002/voice-agent/tools.sock
VA_MAX_TOOL_ROUNDS=2
VA_SEARCH_BACKEND=ddg
VA_SEARX_URL=
VA_SEARCH_RESULTS=4
VA_SEARCH_SNIPPET=420
VA_FETCH_CHARS=2500
VA_TOOL_TIMEOUT=15

# ---------------------------------------------------------------- flow
VA_HISTORY_TURNS=6
VA_FLUSH_CHARS=90
VA_BARGE_IN=1
VA_EVENT_SOCK=/run/user/1002/voice-agent/events.sock

# ---------------------------------------------------------------- web ui
# 127.0.0.1: no auth on this UI, and the browser mic needs https or localhost
# anyway. Reach it with `ssh -L 8090:localhost:8090 MITLAB-JETSON`.
VA_WEB_HOST=127.0.0.1
VA_WEB_PORT=8090
VA_WEB_UI=/home/ari/voice-agent/ui.html
