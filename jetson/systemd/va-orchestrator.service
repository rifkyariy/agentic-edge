[Unit]
Description=Voice agent: orchestrator
After=va-asr.service va-tts.service va-llm.service va-tools.service
Wants=va-asr.service va-tts.service va-llm.service va-tools.service

[Service]
EnvironmentFile=%h/.config/voice-agent/config.env
EnvironmentFile=-%h/.config/voice-agent/runtime.env
ExecStart=/usr/bin/python3 %h/voice-agent/orchestrator.py
RuntimeDirectory=voice-agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
