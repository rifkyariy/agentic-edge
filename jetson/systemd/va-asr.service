[Unit]
Description=Voice agent: ASR (whisper.cpp)
After=network.target

[Service]
EnvironmentFile=%h/.config/voice-agent/config.env
ExecStart=/usr/bin/python3 %h/voice-agent/asr_service.py
RuntimeDirectory=voice-agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
