[Unit]
Description=Voice agent: web UI
After=va-orchestrator.service
Wants=va-orchestrator.service

[Service]
EnvironmentFile=%h/.config/voice-agent/config.env
ExecStart=/usr/bin/python3 %h/voice-agent/web_service.py
RuntimeDirectory=voice-agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
