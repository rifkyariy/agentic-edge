[Unit]
Description=Voice agent: TTS (piper)
After=network.target

[Service]
EnvironmentFile=%h/.config/voice-agent/config.env
ExecStart=/usr/bin/python3 %h/voice-agent/tts_service.py
RuntimeDirectory=voice-agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5
# No Nice=-5 as on the Pi: a user unit cannot raise its own priority, and the
# unit would fail to start. TTS runs on the CPU while decode is on the GPU.

[Install]
WantedBy=default.target
