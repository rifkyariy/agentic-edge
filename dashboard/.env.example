# Copy to .env.local and edit if your boards are not this lab's.
# Values are whatever `ssh <name>` accepts: an ~/.ssh/config alias, or user@host.
# Verify with: npm run check

PI_HOST=MITLAB-EDGE
PI_REPO=~/Research/agentic-edge
PI_PY=~/Research/eval-venv/bin/python3

JETSON_HOST=MITLAB-JETSON
JETSON_REPO=~/research/agentic-edge
JETSON_PY=~/venvs/eval/bin/python3

# Card headings, if the hardware differs
# PI_LABEL=Raspberry Pi 5
# JETSON_LABEL=Jetson Orin Nano
