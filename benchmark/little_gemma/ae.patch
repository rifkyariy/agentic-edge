+            CUDA_CHECK(cudaMalloc(&kv->px_k[L], bytes));
+            CUDA_CHECK(cudaMalloc(&kv->px_v[L], bytes));
+            total += 2 * bytes;
+        }
+        fprintf(stderr, "kv prefix snapshot: %.1f MiB\n", total / 1048576.0);
+    }
     for (int L = 0; L < kv->n_layer; L++) {
         if (!kv->k[L]) continue;
         int rows = n < kv->seq[L] ? n : kv->seq[L];
