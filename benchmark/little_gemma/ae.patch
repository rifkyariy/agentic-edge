+// 30-80 ms forward); a hash of n-gram -> last position if it ever shows up.
+static int ngram_draft(const int *h, int n, int *d, int k) {
+    for (int w = 3; w >= 2; w--) {
+        if (n <= w) continue;
+        for (int s = n - w - 1; s >= 0; s--) {
+            if (memcmp(h + s, h + n - w, (size_t)w * sizeof *h)) continue;
+            int m = n - (s + w) < k ? n - (s + w) : k;
+            memcpy(d, h + s + w, (size_t)m * sizeof *d);
+            return m;
+        }
+    }
+    return 0;
